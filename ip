"""
URL -> IP Lookup (INTERACTIVE VERSION)
----------------------------------------
Script chalao, phir ye aapse poochega:
  1) Input file ka path         (jaise C:\\data.xlsx ya C:\\data.csv)
  2) File ke columns dikhayega, aap batao kis column mein URLs hain
  3) Output file ka naam        (jaise result)
  4) Output file type           (excel ya csv)

Bas itna hi. Result usi format mein save ho jayega jo aap choose karoge.
"""

import socket
import re
import sys
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor, as_completed

import pandas as pd


def read_file(path: Path) -> pd.DataFrame:
    suffix = path.suffix.lower()
    if suffix in (".xlsx", ".xls", ".xlsm"):
        return pd.read_excel(path)
    elif suffix == ".csv":
        return pd.read_csv(path)
    elif suffix == ".tsv":
        return pd.read_csv(path, sep="\t")
    else:
        raise ValueError(f"Ye file type support nahi hai: {suffix} (sirf .xlsx, .xls, .csv, .tsv chalega)")


def extract_hostname(url: str) -> str:
    if not isinstance(url, str) or not url.strip():
        return ""
    url = url.strip()
    if "://" not in url:
        url = "http://" + url
    try:
        from urllib.parse import urlparse
        host = urlparse(url).hostname
        return host if host else ""
    except Exception:
        match = re.search(r"://([^/:?#]+)", url)
        return match.group(1) if match else url


def resolve_ip(url: str) -> str:
    hostname = extract_hostname(url)
    if not hostname:
        return "INVALID_URL"
    try:
        return socket.gethostbyname(hostname)
    except socket.gaierror:
        return "RESOLVE_FAILED"
    except Exception as e:
        return f"ERROR: {e}"


def ask_input_path() -> Path:
    while True:
        raw = input("\n👉 Input file ka path do (jaise C:\\data.xlsx ya /home/user/data.csv): ").strip().strip('"')
        path = Path(raw)
        if not path.exists():
            print(f"[ERROR] Ye file nahi mili: {path}. Dobara try karo.")
            continue
        return path


def ask_column(df: pd.DataFrame) -> str:
    print("\n📋 File mein ye columns hain:")
    for i, col in enumerate(df.columns, start=1):
        print(f"   {i}. {col}")

    while True:
        raw = input("\n👉 URLs kis column mein hain? Column ka NAME ya NUMBER likho: ").strip()
        if raw.isdigit():
            idx = int(raw) - 1
            if 0 <= idx < len(df.columns):
                return df.columns[idx]
            print("[ERROR] Ye number list mein nahi hai. Dobara try karo.")
        elif raw in df.columns:
            return raw
        else:
            print("[ERROR] Ye column nahi mila. Naam ya number sahi se likho.")


def ask_output_name() -> str:
    raw = input("\n👉 Output file ka naam kya rakhna hai (bina extension, jaise: result): ").strip()
    return raw if raw else "output"


def ask_output_type() -> str:
    while True:
        raw = input("\n👉 Output kis format mein chahiye? (1 = Excel, 2 = CSV): ").strip()
        if raw in ("1", "excel", "xlsx"):
            return "xlsx"
        elif raw in ("2", "csv"):
            return "csv"
        print("[ERROR] Sirf 1 ya 2 likho.")


def main():
    print("=" * 50)
    print(" URL -> IP Lookup Tool")
    print("=" * 50)

    # 1) input path
    input_path = ask_input_path()
    try:
        df = read_file(input_path)
    except Exception as e:
        print(f"[ERROR] File read nahi ho payi: {e}")
        sys.exit(1)

    # 2) column choose
    url_col = ask_column(df)

    # 3) output name
    output_name = ask_output_name()

    # 4) output type
    output_type = ask_output_type()

    # ---- IP lookup ----
    urls = df[url_col].tolist()
    total = len(urls)
    print(f"\n[INFO] Total {total} URLs mile. IP nikaal rahe hain...")

    results = [None] * total
    with ThreadPoolExecutor(max_workers=10) as executor:
        future_to_idx = {executor.submit(resolve_ip, url): idx for idx, url in enumerate(urls)}
        done = 0
        for future in as_completed(future_to_idx):
            idx = future_to_idx[future]
            results[idx] = future.result()
            done += 1
            if done % 25 == 0 or done == total:
                print(f"[INFO] {done}/{total} ho gaya...")

    df["IP_Address"] = results

    # ---- save output (same folder as input file) ----
    output_path = input_path.parent / f"{output_name}.{output_type}"
    if output_type == "xlsx":
        df.to_excel(output_path, index=False)
    else:
        df.to_csv(output_path, index=False)

    print(f"\n✅ [DONE] Result save ho gaya: {output_path}")


if __name__ == "__main__":
    main()
