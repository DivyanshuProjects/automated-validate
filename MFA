

import os
import re
import sys
import time
import concurrent.futures as cf
from urllib.parse import urljoin, urlparse

import pandas as pd
import requests
from requests.adapters import HTTPAdapter, Retry
from tqdm import tqdm
from openpyxl import load_workbook
from openpyxl.styles import PatternFill, Font
from openpyxl.utils import get_column_letter

# ----------------------------- CONFIG -----------------------------
OUTPUT_FILE = "mfa_audit_results_advanced.xlsx"

MAX_WORKERS = 10          # kitne URLs parallel mein check honge
REQUEST_TIMEOUT = 10       # seconds
RETRIES = 2                 # per URL retry count on failure

# Homepage ke alawa in common paths ko bhi check karega
EXTRA_PATHS = [
    "/login",
    "/signin",
    "/sign-in",
    "/account/security",
    "/settings/security",
    "/security",
    "/mfa",
    "/2fa",
]

HEADERS = {
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
        "(KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
    )
}

# ------------------------- DETECTION RULES -------------------------
# Strong signals -> higher weight (very likely real MFA feature)
STRONG_TERMS = [
    r"\bmfa\b", r"\b2fa\b", r"multi.?factor authentication",
    r"two.?factor authentication", r"\botp\b", r"\btotp\b",
    r"webauthn", r"passkey", r"authenticator app", r"google authenticator",
    r"authy", r"security key",
]

# Weak signals -> could be false positive on their own (need context)
WEAK_TERMS = [
    r"verification code", r"security.?code", r"enter.{0,15}code",
    r"one.?time.?password", r"two.?step verification",
]

STRONG_PATTERN = re.compile("|".join(STRONG_TERMS), re.IGNORECASE)
WEAK_PATTERN = re.compile("|".join(WEAK_TERMS), re.IGNORECASE)


def build_session() -> requests.Session:
    """Session with retry/backoff so temporary network hiccups don't
    get mislabeled as 'MFA Not Found'."""
    session = requests.Session()
    retry_cfg = Retry(
        total=RETRIES,
        backoff_factor=0.5,
        status_forcelist=[429, 500, 502, 503, 504],
    )
    adapter = HTTPAdapter(max_retries=retry_cfg)
    session.mount("http://", adapter)
    session.mount("https://", adapter)
    return session


def score_page(text: str):
    """Return (strong_matches, weak_matches)."""
    strong = set(m.lower() for m in STRONG_PATTERN.findall(text))
    weak = set(m.lower() for m in WEAK_PATTERN.findall(text))
    return strong, weak


def confidence_from_matches(strong: set, weak: set) -> str:
    if strong:
        return "High"
    if len(weak) >= 2:
        return "Medium"
    if weak:
        return "Low"
    return "Not Found"


def fetch(session: requests.Session, url: str):
    try:
        r = session.get(url, headers=HEADERS, timeout=REQUEST_TIMEOUT, allow_redirects=True)
        return r
    except requests.RequestException:
        return None


def check_url(base_url: str) -> dict:
    session = build_session()
    base_url = base_url.strip()
    if not base_url.startswith(("http://", "https://")):
        base_url = "https://" + base_url

    all_strong, all_weak = set(), set()
    checked_pages = []
    status_code = "Error"
    final_url = ""
    error_msg = ""

    try:
        # 1) Homepage check
        resp = fetch(session, base_url)
        if resp is not None:
            status_code = resp.status_code
            final_url = resp.url
            s, w = score_page(resp.text)
            all_strong |= s
            all_weak |= w
            checked_pages.append(base_url)

            # 2) If nothing strong found yet, probe common login/security paths
            if not all_strong:
                parsed = urlparse(final_url or base_url)
                root = f"{parsed.scheme}://{parsed.netloc}"
                for path in EXTRA_PATHS:
                    if all_strong:
                        break  # already confident, stop early (saves requests)
                    candidate = urljoin(root, path)
                    r2 = fetch(session, candidate)
                    if r2 is not None and r2.status_code < 400:
                        s2, w2 = score_page(r2.text)
                        all_strong |= s2
                        all_weak |= w2
                        checked_pages.append(candidate)
        else:
            error_msg = "Request failed after retries (timeout/connection error)"

    except Exception as e:  # noqa: BLE001
        error_msg = str(e)

    confidence = confidence_from_matches(all_strong, all_weak) if not error_msg else "Unable to Check"

    return {
        "URL": base_url,
        "Status Code": status_code,
        "Final URL": final_url,
        "MFA Confidence": confidence,
        "Strong Matches": ", ".join(sorted(all_strong)) if all_strong else "",
        "Weak Matches": ", ".join(sorted(all_weak)) if all_weak else "",
        "Pages Checked": " | ".join(checked_pages),
        "Error": error_msg,
    }


def style_output(path: str):
    """Color-code rows and add a summary sheet."""
    wb = load_workbook(path)
    ws = wb.active

    fills = {
        "High": PatternFill("solid", fgColor="C6EFCE"),      # green
        "Medium": PatternFill("solid", fgColor="FFEB9C"),    # yellow
        "Low": PatternFill("solid", fgColor="FFE0B2"),       # orange
        "Not Found": PatternFill("solid", fgColor="FFC7CE"), # red
        "Unable to Check": PatternFill("solid", fgColor="D9D9D9"),  # grey
    }

    header = [c.value for c in ws[1]]
    conf_col_idx = header.index("MFA Confidence") + 1

    counts = {}
    for row in ws.iter_rows(min_row=2):
        conf_val = row[conf_col_idx - 1].value
        counts[conf_val] = counts.get(conf_val, 0) + 1
        fill = fills.get(conf_val)
        if fill:
            for cell in row:
                cell.fill = fill

    # Bold header
    for cell in ws[1]:
        cell.font = Font(bold=True)

    # Auto width (approx)
    for i, col_name in enumerate(header, start=1):
        max_len = max([len(str(col_name))] + [
            len(str(ws.cell(row=r, column=i).value or "")) for r in range(2, ws.max_row + 1)
        ])
        ws.column_dimensions[get_column_letter(i)].width = min(max_len + 2, 60)

    # Summary sheet
    summary = wb.create_sheet("Summary")
    summary.append(["MFA Confidence", "Count"])
    summary["A1"].font = Font(bold=True)
    summary["B1"].font = Font(bold=True)
    for key, val in counts.items():
        summary.append([key, val])

    wb.save(path)


def load_sheet(file_path: str) -> pd.DataFrame:
    """Load .xlsx/.xls or .csv into a DataFrame, based on extension."""
    ext = os.path.splitext(file_path)[1].lower()
    if ext in (".xlsx", ".xls", ".xlsm"):
        return pd.read_excel(file_path)
    elif ext == ".csv":
        return pd.read_csv(file_path)
    else:
        raise ValueError(f"Unsupported file type '{ext}'. Only .xlsx, .xls, .csv supported.")


def prompt_for_file_path() -> str:
    while True:
        path = input("📂 Excel ya CSV file ka path daalo (e.g. urls.xlsx): ").strip().strip('"')
        if not path:
            print("   Path khaali nahi ho sakta, dobara try karo.\n")
            continue
        if not os.path.isfile(path):
            print(f"   File nahi mili: '{path}'. Path check karke dobara try karo.\n")
            continue
        return path


def prompt_for_column(df: pd.DataFrame) -> str:
    print(f"\n📋 Sheet mein ye columns mile ({len(df)} rows):")
    for i, col in enumerate(df.columns, start=1):
        # Show a sample value so it's easier to identify the right column
        sample = ""
        non_null = df[col].dropna()
        if len(non_null) > 0:
            sample = f"   (e.g. '{non_null.iloc[0]}')"
        print(f"   {i}. {col}{sample}")

    while True:
        choice = input("\n🔎 Kaunsa column URL/IP wala hai? (naam ya number type karo): ").strip()
        if not choice:
            print("   Kuch to select karo.\n")
            continue
        # Allow selection by number
        if choice.isdigit():
            idx = int(choice) - 1
            if 0 <= idx < len(df.columns):
                return df.columns[idx]
            print("   Ye number list mein nahi hai, dobara try karo.\n")
            continue
        # Allow selection by exact/partial column name
        matches = [c for c in df.columns if c.strip().lower() == choice.strip().lower()]
        if matches:
            return matches[0]
        partial = [c for c in df.columns if choice.strip().lower() in c.strip().lower()]
        if len(partial) == 1:
            return partial[0]
        print(f"   Column '{choice}' nahi mila. Column ka number ya poora naam try karo.\n")


def main():
    # Allow file path as a command-line arg too: python mfa_audit_advanced.py urls.csv
    if len(sys.argv) > 1:
        file_path = sys.argv[1]
        if not os.path.isfile(file_path):
            print(f"File nahi mili: '{file_path}'")
            file_path = prompt_for_file_path()
    else:
        file_path = prompt_for_file_path()

    df = load_sheet(file_path)
    if df.empty:
        print("Sheet mein koi data nahi mila.")
        return

    url_column = prompt_for_column(df)
    urls = df[url_column].dropna().tolist()
    print(f"\n✅ '{url_column}' column se {len(urls)} URL/IP entries mili. Audit shuru ho raha hai...\n")

    results = []
    with cf.ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
        futures = {executor.submit(check_url, u): u for u in urls}
        for future in tqdm(cf.as_completed(futures), total=len(futures), desc="Auditing URLs"):
            results.append(future.result())

    result_df = pd.DataFrame(results)
    result_df.to_excel(OUTPUT_FILE, index=False)
    style_output(OUTPUT_FILE)

    print(f"\nDone! {len(results)} URLs checked. Results saved to: {OUTPUT_FILE}")
    print(result_df["MFA Confidence"].value_counts())


if __name__ == "__main__":
    start = time.time()
    main()
    print(f"Total time: {time.time() - start:.1f}s")
